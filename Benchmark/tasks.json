    "graph_file": "t6.txt",
    "graph_call": {
      "tool": "query_graph",
      "args": {
        "cypher": "MATCH (c:Class {user_id: $user_id, repo_name: $repo_name}) RETURN c.name AS name, c.file_path AS file ORDER BY name"
      }
    },
    "baseline": {
      "cmd": [
        "git",
        "grep",
        "-n",
        "-E",
        "^\\s*(export )?(default )?class ",
