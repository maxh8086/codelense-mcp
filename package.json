{
  "name": "codelense-mcp",
  "version": "1.0.0",
  "description": "Multi-tenant code knowledge graph on Neo4j with a Tree-sitter indexer, heuristic cross-file linker and an MCP server (stdio + SSE).",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "codelense-mcp": "src/cli.js",
    "repo-graph-client": "client/repo-graph-client.js"
  },
  "scripts": {
    "start": "node src/cli.js serve",
    "stdio": "node src/cli.js stdio",
    "client": "node client/repo-graph-client.js",
    "test": "node --test tests/",
    "test:unit": "node --test tests/unit/",
    "init-env": "node scripts/init-env.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mcp", "neo4j", "tree-sitter", "code-graph", "graphrag"],
  "author": "maxh8086",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "neo4j-driver": "^6.2.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6",
    "zod": "^4.6.5"
  }
}
