# Copy to .env (or run `npm run init-env`, which generates secrets for you).
NEO4J_AUTH=neo4j/change-me-please
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
CODELENSE_PORT=8787
CODELENSE_USER_ID=default
# Optional bearer token (rg_live_...). When set, every API and MCP route requires it.
CODELENSE_TOKEN=
# Host folder mounted read-only at /workspace for the UI folder picker.
WORKSPACE_DIR=./
# Point at an external Bolt/openCypher database instead of the bundled one:
# NEO4J_URI=bolt://your-host:7687
