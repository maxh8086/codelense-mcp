# systemd unit. Install:
#   sudo cp codelense-client.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now codelense-client
# Edit User, WorkingDirectory and the config path first. The client only reads your repo.
[Unit]
Description=codelense-client (repo watcher -> codelense-mcp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/opt/codelense-mcp
ExecStart=/usr/bin/node client/codelense-client.js /etc/codelense/codelense-client.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
